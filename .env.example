# ShopGuard AI - Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or CCTV credentials to version control.

# Camera 01 RTSP Stream URL
# Example format: rtsp://username:password@192.168.1.100:554/stream1
CAMERA_01_URL=rtsp://admin:password@192.168.1.100:554/h264Preview_01_main

# Camera 02 RTSP Stream URL (optional)
# CAMERA_02_URL=rtsp://admin:password@192.168.1.101:554/h264Preview_01_main

# Phase 2: Local Security Agent API Authentication
# Secret key used for authenticating local API control requests (e.g. arm/disarm)
# If left empty, ShopGuard will automatically generate a secure local key in config/agent_api_key.secret
SHOPGUARD_API_KEY=your_secure_local_agent_api_key_here
